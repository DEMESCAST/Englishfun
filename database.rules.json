{
  "rules": {
    ".read": false,
    ".write": false,

    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['nickname', 'normalizedNickname', 'playerCode', 'createdAt'])",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16 && (!data.exists() || newData.val() === data.val())"
        },
        "normalizedNickname": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32 && (!data.exists() || newData.val() === data.val())"
        },
        "playerCode": {
          ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 14 && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "ranking": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['uid', 'nickname', 'totalGeneral', 'updatedAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val() === root.child('players').child($uid).child('nickname').val()"
        },
        "totalGeneral": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
        },
        "totalScore": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
        },
        "bestPerCombo": {
          ".validate": "!newData.exists() || newData.hasChildren()",
          "$combo": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
          }
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "gameHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$entry": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['uid', 'name', 'score', 'generalPoints', 'category', 'mode', 'date'])",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val() === root.child('players').child($uid).child('nickname').val()"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "generalPoints": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
          },
          "correct": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
          },
          "total": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 100)"
          },
          "maxCombo": {
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 100)"
          },
          "category": {
            ".validate": "newData.isString() && newData.val().matches(/^(animals|food|colors|numbers|body|objects|family|clothes|weather|actions|sentences|review)$/)"
          },
          "mode": {
            ".validate": "newData.isString() && newData.val().matches(/^(learn|quiz|dictation|review|memory)$/)"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 30"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
